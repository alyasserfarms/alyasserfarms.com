import type { Metadata } from "next";
import localFont from "next/font/local";
import "./globals.css";
import "./living.css";

const arabic = localFont({
  src: [
    { path: "../assets/fonts/noto-sans-arabic-arabic-wght-normal.woff2", weight: "100 900", style: "normal" },
    { path: "../assets/fonts/noto-sans-arabic-latin-wght-normal.woff2", weight: "100 900", style: "normal" },
  ],
  variable: "--font-arabic",
  display: "swap",
});

const display = localFont({
  src: "../assets/fonts/aref-ruqaa-arabic-700-normal.woff2",
  variable: "--font-display",
  weight: "700",
  display: "swap",
});

export const metadata: Metadata = {
  title: "مزارع آل ياسر | الخير له أصل",
  description: "مزارع آل ياسر، اكتشف عالمًا من اللحوم والدواجن والخضروات والفواكه والألبان ومنتجات المزرعة. معاينة تجربة المتجر.",
  robots: { index: false, follow: false },
};

export default function RootLayout({ children }: Readonly<{ children: React.ReactNode }>) {
  return <html lang="ar" dir="rtl" className={`${arabic.variable} ${display.variable}`}><body><a className="skip-link" href="#main">تجاوز إلى المحتوى</a>{children}</body></html>;
}
