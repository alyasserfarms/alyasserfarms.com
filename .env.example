ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Set true with HTTPS deployment. False only for local HTTP preview.
ADMIN_COOKIE_SECURE=false
# FARM_DATA_DIR=/absolute/path/to/persistent/private/data
# After running db:import, set the Supabase Session pooler URI here and restart the app.
# For the shared Supabase pooler, use its CA certificate and full TLS verification.
# Replace the certificate path with its absolute path on the deployment server.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/certs/supabase-prod-ca-2021.crt
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
