@import "tailwindcss";

:root {
  --forest: #183d2b;
  --forest-deep: #102b1e;
  --ivory: #f6f1e7;
  --paper: #fffcf6;
  --field: #9cb36b;
  --harvest: #cba44d;
  --sun: #e9c857;
  --sage: #e6e9dc;
  --ink: var(--forest);
  --surface: var(--ivory);
  --action-bg: var(--forest);
  --action-ink: var(--ivory);
  --muted: #52634f;
  --page-gutter: clamp(20px, 3.6vw, 64px);
  --space-section: clamp(88px, 10vw, 152px);
  --button-radius: 0;
  --motion-fast: 180ms;
  --motion-ease: cubic-bezier(.2, .65, .3, 1);
  --z-header: 30;
}

@theme inline {
  --color-background: var(--surface);
  --color-foreground: var(--ink);
  --font-sans: var(--font-arabic), sans-serif;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 104px; }
body { margin: 0; background: var(--surface); color: var(--ink); font-family: var(--font-arabic), Arial, sans-serif; font-size: 16px; line-height: 1.8; -webkit-font-smoothing: antialiased; }
body:has(dialog[open]) { overflow: hidden; }
button, input { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
button { cursor: pointer; }
button, a { transition: color var(--motion-fast), background-color var(--motion-fast), transform var(--motion-fast); }
button:active, .button:active { transform: translateY(2px); }
a { color: inherit; text-decoration: none; }
button { color: inherit; }
button, input { border-radius: 0; }
button { border: 0; }
button:disabled { cursor: default; }
:focus-visible { outline: 3px solid var(--forest); outline-offset: 5px; }
.hero :focus-visible, .story-section :focus-visible, .site-footer :focus-visible { outline-color: var(--sun); }
::selection { background: var(--harvest); color: var(--forest-deep); }
h1, h2, h3, p, figure { margin: 0; }
h1, h2, h3 { text-wrap: balance; font-weight: 600; }
h2 { font-size: clamp(30px, 3.6vw, 54px); line-height: 1.45; }
h3 { font-size: 21px; line-height: 1.6; }
p { text-wrap: pretty; }
img { display: block; }
svg { flex-shrink: 0; }
.frame { width: 100%; padding-inline: var(--page-gutter); max-width: 1680px; margin-inline: auto; }
.section { margin-block: var(--space-section); }
.photo { position: relative; overflow: hidden; background: var(--sage); }
.photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 700ms var(--motion-ease); }
.skip-link { position: fixed; top: -100px; inset-inline-start: 20px; padding: 12px 24px; background: var(--forest); color: var(--ivory); z-index: 100; }
.skip-link:focus { top: 12px; }
.button, .arrow-link, .text-link { display: inline-flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 48px; }
.button { background: var(--action-bg); color: var(--action-ink); padding: 12px 26px; border-radius: var(--button-radius); font-weight: 600; }
.button:hover { background: var(--forest-deep); }
.button-sun { --action-bg: var(--sun); --action-ink: var(--forest-deep); }
.button-sun:hover { background: var(--ivory); }
.arrow-link { font-weight: 600; }
.arrow-link:hover svg, .text-link:hover svg { transform: translate(-3px, -3px); }
.arrow-link svg, .text-link svg { transition: transform var(--motion-fast); }
.text-link { font-size: 16px; }
.icon-button { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; height: 44px; padding: 8px; background: transparent; }
.icon-button:hover { background: var(--sage); }

/* A calm, solid navigation bar gives the landscape the first word. */
.site-header { position: sticky; top: 0; z-index: var(--z-header); background: var(--ivory); }
.header-inner { min-height: 100px; display: flex; align-items: center; justify-content: space-between; gap: 32px; }
.brand-name { display: inline-flex; align-items: center; min-height: 48px; flex-shrink: 0; }
.brand-name > span { font-size: 25px; font-weight: 650; white-space: nowrap; }
.brand-name img { width: 88px; height: 88px; object-fit: contain; }
.desktop-nav { display: flex; gap: clamp(20px, 2.5vw, 42px); align-items: center; }
.desktop-nav a { display: inline-flex; align-items: center; min-height: 48px; font-size: 16px; }
.desktop-nav a:hover { color: var(--muted); }
.header-actions { display: flex; align-items: center; gap: 12px; }
.cart-button { display: flex; align-items: center; justify-content: center; gap: 9px; min-height: 44px; padding: 6px; background: transparent; }
.cart-count { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 50%; font-size: 16px; background: var(--forest); color: var(--ivory); }
.mobile-menu-button { display: none; }

/* Landscape, title, invitation: no other layer competes with the first screen. */
.hero { position: relative; min-height: min(760px, calc(100svh - 100px)); isolation: isolate; color: var(--ivory); display: flex; align-items: center; }
.hero-photo, .hero-video, .hero-scrim { position: absolute; inset: 0; z-index: -3; }
.hero-photo img { object-position: center 54%; }
.farm-video video { display: block; width: 100%; height: 100%; object-fit: cover; }
.hero-video { z-index: -2; }
.hero-video video { opacity: 0; transition: opacity 800ms; }
.hero-video.is-ready video { opacity: 1; }
.hero-scrim { z-index: -1; background: rgb(8 23 14 / 64%); }
.hero-content { padding-block: 80px 150px; }
.hero h1 { font-size: clamp(64px, 7.6vw, 116px); line-height: 1.5; font-weight: 650; }
.hero-content > p { margin-block: 16px 32px; font-size: clamp(18px, 1.6vw, 23px); line-height: 1.9; max-width: 500px; }
.hero-bottom { position: absolute; bottom: 24px; inset-inline: 0; display: flex; justify-content: space-between; align-items: center; font-size: 16px; }
.hero-bottom a { width: 48px; height: 48px; display: grid; place-items: center; }
.video-toggle { position: absolute; bottom: 30px; inset-inline-end: calc(var(--page-gutter) + 64px); z-index: 3; background: rgb(16 43 30 / 86%); color: var(--ivory); display: inline-flex; align-items: center; gap: 10px; padding: 9px 16px; min-height: 44px; }
.hero-video .video-toggle { pointer-events: auto; }
.hero-video:has(.video-toggle) { z-index: auto; pointer-events: none; }
.hero-video video { position: absolute; inset: 0; z-index: 0; }
.hero-content, .hero-bottom { position: relative; z-index: 1; }
.hero-content a, .hero-bottom a { pointer-events: auto; }
.hero-bottom { position: absolute; }
.hero-scrim { z-index: 1; pointer-events: none; }
.hero-content, .hero-bottom { z-index: 2; }
.hero-video .video-toggle { z-index: 4; }
.preview-note { display: flex; gap: 10px; align-items: baseline; padding-block: 18px; background: var(--sage); }
.preview-note p { font-size: 16px; line-height: 1.8; }

.about-section { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(48px, 8vw, 140px); align-items: center; }
.about-copy h2 { font-size: clamp(28px, 3vw, 44px); margin-bottom: 32px; }
.statement { font-size: clamp(24px, 2.4vw, 36px); font-weight: 450; line-height: 1.65; }
.about-copy > p:not(.statement) { max-width: 470px; margin-block: 28px 20px; font-size: 16px; line-height: 2; }
.about-image .photo { aspect-ratio: 1 / 1.08; }
.about-image figcaption { margin-top: 14px; font-size: 16px; }
.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 28px; margin-bottom: 40px; }
.section-heading p { margin-top: 14px; font-size: 16px; }
.category-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 20px; }
.category-item .photo { aspect-ratio: 3 / 4; }
.category-item:nth-child(even) { padding-top: 44px; }
.category-item:hover .photo img { transform: scale(1.045); }
.category-item > div:last-child { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding-top: 15px; }
.category-item h3 { font-size: 16px; }
.products-section { margin-bottom: var(--space-section); }
.section-heading .demo-note { font-size: 16px; line-height: 1.8; }
.product-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; }
.product-filters button { min-height: 44px; padding: 9px 21px; background: transparent; font-size: 16px; }
.product-filters button:hover { background: var(--sage); }
.product-filters button[aria-pressed="true"] { background: var(--forest); color: var(--ivory); }
.product-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 28px; align-items: start; }
.product-featured { grid-row: span 2; }
.product-photo-button { display: block; padding: 0; background: none; width: 100%; position: relative; text-align: start; }
.product .photo { aspect-ratio: 1.2; }
.product-featured .photo { aspect-ratio: .85; }
.product-photo-button:hover img { transform: scale(1.035); }
.photo-action { position: absolute; bottom: 12px; inset-inline-end: 12px; width: 40px; height: 40px; display: grid; place-items: center; background: var(--ivory); }
.product-info { display: flex; gap: 12px; justify-content: space-between; align-items: start; padding-top: 18px; }
.product-name { padding: 0; background: none; text-align: start; }
.product-name h3 { font-size: 19px; }
.product-info p { margin-top: 4px; font-size: 16px; }
.add-button { background: var(--sage); width: 44px; height: 44px; display: inline-grid; place-items: center; flex-shrink: 0; }
.add-button:hover { background: var(--forest); color: var(--ivory); }
.price { display: flex; align-items: baseline; gap: 9px; margin-top: 12px; }
.price > bdi { font-size: 28px; font-weight: 600; line-height: 1.5; }
.price > span { font-size: 16px; }
.product-grid > .product:last-child:not(.product-featured) { grid-column: 2 / 4; display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; align-items: center; }
.product-grid > .product:last-child .product-photo-button { grid-row: span 2; }
.product-grid > .product:last-child .product-info { padding-top: 0; }
.product-grid > .product:last-child .price { margin-top: 0; align-self: start; }
.product-grid.is-filtered { grid-template-columns: repeat(3, 1fr); }
.product-grid.is-filtered > .product:last-child { grid-column: auto; display: block; }
.product-grid.is-filtered > .product:last-child .product-info { padding-top: 18px; }
.product-grid.is-filtered > .product:last-child .price { margin-top: 12px; }
.catalogue-status { font-size: 16px; margin-top: 28px; }

.story-section { background: var(--forest); color: var(--ivory); padding-block: 64px; }
.story-inner { display: grid; grid-template-columns: .8fr 1.3fr; gap: 40px 64px; align-items: center; }
.story-copy h2 { font-size: clamp(44px, 5.3vw, 78px); line-height: 1.4; }
.story-copy p { margin-block: 28px 20px; max-width: 330px; font-size: 16px; }
.story-photo { aspect-ratio: 1.25; }
.story-caption { grid-column: 1 / -1; display: flex; align-items: center; gap: 12px; }
.story-caption p { font-size: 16px; }
.film-layout { display: grid; grid-template-columns: 2fr .8fr; gap: 48px; align-items: center; }
.film-video { position: relative; aspect-ratio: 16 / 9; background: var(--forest-deep); }
.film-video video { object-fit: cover; }
.film-play { position: absolute; inset: auto; top: 50%; left: 50%; transform: translate(-50%, -50%); margin: 0; display: flex; align-items: center; justify-content: center; gap: 14px; width: max-content; height: 60px; padding: 12px 26px; background: var(--ivory); color: var(--forest); }
.film-copy h3 { font-size: 28px; }
.film-copy > p { margin-top: 18px; }
.film-copy .text-link { margin-top: 18px; }
.demo-note { font-size: 16px; line-height: 1.9; }
.video-error { position: absolute; inset-inline: 16px; bottom: 6px; background: var(--ivory); color: var(--forest); padding: 8px; font-size: 16px; }
.delivery-section { background: var(--sage); padding-block: 64px; }
.delivery-steps { list-style: none; padding: 0; margin: 48px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(28px, 6vw, 88px); }
.delivery-steps li { display: grid; grid-template-columns: 44px 1fr; gap: 16px; align-items: center; }
.delivery-steps h3 { font-size: 23px; }
.delivery-steps p { grid-column: 2; font-size: 16px; line-height: 1.9; }
.delivery-note { display: flex; align-items: center; gap: 10px; margin-top: 48px; font-size: 16px; }
.season-section { display: grid; grid-template-columns: 1fr 1fr; background: var(--harvest); padding-block: 0; gap: 0; margin-block: var(--space-section); }
.season-photo { margin-inline-start: calc(var(--page-gutter) * -1); aspect-ratio: 1; }
.season-copy { padding: 56px 12% 48px 0; display: flex; flex-direction: column; align-items: start; justify-content: center; }
.season-copy h2 { font-size: clamp(38px, 4vw, 60px); }
.season-copy .statement { font-size: clamp(23px, 2.2vw, 32px); margin-block: 20px; }
.season-copy > p:not(.statement) { font-size: 16px; max-width: 390px; }
.season-copy .button { margin-top: 28px; }
.season-copy > .demo-note { margin-top: 20px; font-size: 16px; }

.site-footer { background: var(--forest-deep); color: var(--ivory); padding-block: 64px 24px; }
.footer-top { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 56px; }
.brand-name-footer > span { font-size: 31px; }
.brand-name-footer img { width: 128px; height: 128px; background: var(--ivory); padding: 8px; }
.footer-top > div:first-child p { margin-top: 12px; }
.footer-top nav { display: grid; grid-template-columns: 1fr 1fr; align-content: start; gap: 12px 28px; }
.footer-top nav a { display: flex; align-items: center; min-height: 44px; }
.footer-contact h2 { font-size: 20px; }
.footer-contact p { font-size: 16px; margin-block: 12px; }
.footer-wordmark { font-size: clamp(64px, 12.2vw, 190px); font-weight: 600; line-height: 1.7; margin-block: 40px 24px; text-align: center; white-space: nowrap; }
.footer-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; font-size: 16px; }
.media-credits { margin-top: 28px; max-width: 900px; font-size: 16px; }
.media-credits summary { cursor: pointer; min-height: 44px; }
.media-credits p { margin-block: 12px; }
.media-credits ul { padding-inline-start: 20px; direction: ltr; text-align: start; overflow-wrap: anywhere; }
.media-credits a { text-decoration: underline; text-underline-offset: 4px; }

/* Native dialogs supply focus containment, Escape and focus restoration. */
.modal { padding: 0; border: 0; background: var(--ivory); color: var(--forest); width: min(620px, calc(100vw - 32px)); max-height: calc(100dvh - 48px); margin: auto; }
.modal::backdrop { background: rgb(8 23 14 / 72%); }
.modal-inner { padding: 32px; }
.modal-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
.modal-heading h2 { font-size: 28px; }
.modal-description { font-size: 16px; margin-bottom: 24px; }
.search-label { display: block; font-size: 16px; margin-bottom: 10px; }
.search-input { display: flex; gap: 12px; align-items: center; background: var(--paper); padding: 8px 16px; }
.search-input input { width: 100%; min-width: 0; border: 0; min-height: 44px; background: none; color: var(--forest); }
.search-results { margin-top: 20px; }
.search-results > button { display: flex; gap: 16px; align-items: center; width: 100%; padding: 12px 0; background: none; text-align: start; }
.search-results > button:hover { background: var(--sage); }
.search-results img { object-fit: cover; width: 64px; height: 64px; }
.search-results span { flex: 1; }
.search-results small { display: block; margin-top: 4px; font-size: 16px; }
.menu-modal nav { display: grid; gap: 8px; }
.menu-modal nav a { display: flex; align-items: center; justify-content: space-between; min-height: 56px; font-size: 20px; }
.menu-modal .modal-inner > p { margin-top: 32px; }
.empty-cart { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 20px; padding-block: 32px; }
.empty-cart h3 { font-size: 23px; }
.empty-cart p { font-size: 16px; }
.cart-items { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px; }
.cart-items li { display: flex; align-items: start; gap: 16px; }
.cart-items img { object-fit: cover; }
.cart-item-details { flex: 1; }
.cart-item-details h3 { font-size: 16px; }
.cart-item-details p { font-size: 16px; }
.quantity-controls { display: flex; align-items: center; gap: 6px; margin-top: 8px; }
.quantity-controls button { background: var(--sage); width: 44px; height: 44px; display: grid; place-items: center; }
.quantity-controls span { min-width: 28px; text-align: center; }
.cart-item-end { display: grid; justify-items: center; gap: 20px; }
.cart-summary { display: flex; justify-content: space-between; align-items: center; padding: 20px; background: var(--sage); margin-top: 32px; }
.cart-summary strong { font-size: 28px; }
.cart-modal .demo-note { margin-block: 16px 24px; }
.cart-modal .button { width: 100%; }
.product-detail .photo { aspect-ratio: 1.6; margin-bottom: 24px; }
.product-detail > p { margin-block: 12px; }
.product-detail .button { margin-top: 20px; }
.toast-region { position: fixed; inset-inline: 20px; bottom: 24px; display: flex; justify-content: center; pointer-events: none; z-index: 40; }
.toast { background: var(--forest); color: var(--ivory); display: flex; align-items: center; gap: 12px; padding: 12px 16px; pointer-events: auto; max-width: 100%; font-size: 16px; }
.toast button { display: grid; place-items: center; width: 44px; height: 44px; flex-shrink: 0; background: transparent; color: inherit; }

@media (min-width: 1680px) { .hero { max-width: 1680px; margin-inline: auto; } }
@media (max-width: 1100px) {
  .desktop-nav { gap: 18px; }
  .desktop-nav a { font-size: 16px; }
  .header-inner { gap: 16px; }
  .brand-name > span { font-size: 21px; }
  .category-grid { grid-template-columns: repeat(3, 1fr); gap: 28px 20px; }
  .category-item:nth-child(even) { padding-top: 0; }
  .category-item .photo { aspect-ratio: 1.15; }
  .product-grid { gap: 20px; }
  .product-info { gap: 8px; }
  .product-name h3 { font-size: 16px; }
  .product-grid > .product:last-child:not(.product-featured) { display: block; }
  .product-grid > .product:last-child .product-info { padding-top: 18px; }
  .film-layout { grid-template-columns: 1.6fr 1fr; gap: 28px; }
  .delivery-steps { gap: 24px; }
  .delivery-steps li { display: block; }
  .delivery-steps h3 { margin-block: 16px 12px; }
  .season-copy { padding-inline-start: 10%; }
  .footer-top { grid-template-columns: 1fr 1fr; }
  .footer-contact { grid-column: 1 / -1; }
}

@media (max-width: 800px) {
  html { scroll-padding-top: 80px; }
  .header-inner { min-height: 80px; }
  .desktop-nav, .desktop-cart-label { display: none; }
  .mobile-menu-button { display: inline-flex; }
  .header-actions { gap: 4px; }
  .brand-name img { height: 66px; width: 66px; }
  .brand-name-footer img { height: 128px; width: 128px; }
  .hero { min-height: 650px; }
  .hero h1 { font-size: 76px; }
  .about-section { gap: 36px; }
  .about-copy > p:not(.statement) { font-size: 16px; }
  .about-copy h2 { margin-bottom: 20px; }
  .about-copy .statement { font-size: 24px; }
  .story-inner { gap: 28px; }
  .story-copy h2 { font-size: 46px; }
  .story-copy p { font-size: 16px; }
  .story-photo { aspect-ratio: .85; }
  .film-layout { grid-template-columns: 1fr; gap: 28px; }
  .film-copy { max-width: 520px; }
  .season-copy { padding-block: 32px; }
  .season-photo { aspect-ratio: auto; }
}

@media (max-width: 600px) {
  :root { --page-gutter: 20px; }
  .brand-name > span { font-size: 19px; }
  .header-inner { gap: 8px; }
  .header-actions { gap: 0; }
  .cart-button { gap: 5px; }
  .cart-count { width: 22px; height: 22px; font-size: 16px; }
  .hero { min-height: 630px; max-height: 830px; height: calc(100svh - 80px); }
  .hero-content { padding-block: 90px 150px; }
  .hero h1 { font-size: clamp(50px, 13.5vw, 74px); line-height: 1.6; white-space: nowrap; }
  .hero-content > p { font-size: 18px; line-height: 2; max-width: 320px; margin-top: 20px; }
  .hero-scrim { background: rgb(8 23 14 / 64%); }
  .hero-photo img, .hero-video video { object-position: 58% center; }
  .hero-bottom { bottom: 20px; font-size: 16px; }
  .video-toggle { bottom: 82px; inset-inline-end: 20px; font-size: 16px; }
  .preview-note { padding-block: 16px; align-items: start; }
  .preview-note svg { margin-top: 4px; }
  .preview-note p { font-size: 16px; }
  .desktop-break { display: none; }
  .about-section { grid-template-columns: 1fr; gap: 32px; }
  .about-copy h2 { font-size: 30px; }
  .about-copy .statement { font-size: 24px; }
  .about-copy .statement br { display: none; }
  .about-copy > p:not(.statement) { margin-block: 24px 16px; }
  .about-image .photo { aspect-ratio: 1.15; }
  .section-heading { align-items: start; flex-direction: column; gap: 12px; margin-bottom: 28px; }
  .section-heading h2 { font-size: 30px; }
  .section-heading p { font-size: 16px; margin-top: 10px; }
  .category-grid { grid-template-columns: repeat(2, 1fr); gap: 28px 16px; }
  .category-item .photo { aspect-ratio: .95; }
  .category-item h3 { font-size: 16px; }
  .category-item > div:last-child { padding-top: 12px; }
  .category-item svg { width: 18px; }
  .product-filters { gap: 4px; }
  .product-filters button { padding: 8px 14px; font-size: 16px; }
  .product-grid { grid-template-columns: 1fr 1fr; gap: 28px 16px; }
  .product-featured { grid-column: 1 / -1; grid-row: auto; }
  .product-featured .photo { aspect-ratio: 1.1; }
  .product .photo { aspect-ratio: 1; }
  .product-featured .photo { aspect-ratio: 1.1; }
  .product-grid > .product:last-child:not(.product-featured) { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; gap: 0 16px; }
  .product-grid > .product:last-child .product-info { padding-top: 0; }
  .product-grid.is-filtered { grid-template-columns: 1fr; }
  .product-grid.is-filtered > .product:last-child { grid-column: 1; display: block; }
  .product-name h3 { font-size: 16px; }
  .product-featured .product-name h3 { font-size: 22px; }
  .product-info { gap: 6px; }
  .product-info p { font-size: 16px; }
  .add-button { width: 44px; height: 44px; }
  .price { gap: 6px; flex-wrap: wrap; }
  .price > bdi { font-size: 25px; }
  .price > span { font-size: 16px; }
  .photo-action { bottom: 8px; inset-inline-end: 8px; width: 32px; height: 32px; }
  .catalogue-status { font-size: 16px; }
  .story-section { padding-block: 48px; }
  .story-inner { grid-template-columns: 1fr; gap: 32px; }
  .story-copy h2 { font-size: 48px; }
  .story-copy p { max-width: 100%; margin-block: 20px 12px; }
  .story-photo { aspect-ratio: 1; }
  .story-caption { grid-column: 1; }
  .film-copy h3 { font-size: 25px; }
  .film-copy > p { font-size: 16px; }
  .film-copy > .demo-note { font-size: 16px; }
  .film-play { min-height: 52px; height: 52px; font-size: 16px; padding: 10px 18px; }
  .delivery-section { padding-block: 40px; }
  .delivery-steps { grid-template-columns: 1fr; gap: 36px; margin-top: 32px; }
  .delivery-steps li { display: grid; grid-template-columns: 36px 1fr; gap: 12px 16px; }
  .delivery-steps h3 { margin: 0; font-size: 22px; }
  .delivery-steps p { grid-column: 2; }
  .delivery-note { align-items: start; margin-top: 32px; }
  .delivery-note svg { margin-top: 4px; }
  .season-section { grid-template-columns: 1fr; }
  .season-photo { aspect-ratio: 1.4; margin-inline: calc(var(--page-gutter) * -1); }
  .season-copy { padding: 36px 0 40px; }
  .season-copy h2 { font-size: 44px; }
  .season-copy .statement { font-size: 24px; }
  .site-footer { padding-top: 44px; }
  .footer-top { grid-template-columns: 1fr; gap: 32px; }
  .brand-name-footer > span { font-size: 29px; }
  .footer-contact { grid-column: 1; }
  .footer-top nav { max-width: 360px; gap: 8px 24px; }
  .footer-wordmark { font-size: 13vw; margin-block: 40px; }
  .footer-bottom { flex-direction: column; gap: 8px; }
  .footer-bottom > span[lang] { align-self: start; }
  .modal-inner { padding: 24px 20px; }
  .modal-heading h2 { font-size: 24px; }
  .cart-items li { gap: 10px; }
  .cart-items img { width: 60px; height: 76px; }
  .cart-item-details h3 { font-size: 16px; }
  .cart-item-end { gap: 12px; }
  .toast-region { bottom: 12px; inset-inline: 12px; }
  .toast { gap: 8px; padding: 10px 12px; font-size: 16px; }
}

@media (max-width: 360px) {
  .brand-name > span { font-size: 16px; }
  .header-actions .icon-button { min-width: 40px; width: 40px; }
  .cart-button { padding-inline: 2px; }
  .hero h1 { font-size: 46px; }
  .product-info { flex-wrap: wrap; }
  .product-featured .product-info { flex-wrap: nowrap; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation: none !important; transition: none !important; }
  .category-item:hover .photo img, .product-photo-button:hover img, button:active, .button:active { transform: none; }
}

@keyframes arrive { from { opacity: .35; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
.is-revealing { animation: arrive 650ms var(--motion-ease) both; }

/* Shared type roles keep components consistent across all breakpoints. */
:root { --type-heading: clamp(30px, 3.6vw, 52px); --type-lead: 24px; }
h2, .about-copy h2, .section-heading h2, .season-copy h2 { font-size: var(--type-heading); }
.statement, .about-copy .statement, .season-copy .statement, .film-copy h3, .delivery-steps h3, .modal-heading h2, .empty-cart h3 { font-size: var(--type-lead); }
.category-item h3, .product-name h3, .product-featured .product-name h3, .cart-item-details h3 { font-size: 16px; }
.footer-contact h2 { font-size: 24px; }
.price > bdi, .cart-summary strong { font-size: 24px; }
.brand-name > span { font-size: 24px; }
.brand-name-footer > span { font-size: 24px; }
.hero-content > p { font-size: 24px; }
@media (max-width: 800px) { .brand-name > span { font-size: 20px; } .hero-content > p { font-size: 18px; } }
@media (max-width: 360px) { .brand-name > span { font-size: 16px; } }

/* Shopping pages share the farm's paper, ink and generous image-led frame. */
.commerce-page { padding-top: 28px; padding-bottom: 88px; min-height: 60svh; }
.breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; font-size: 16px; margin-bottom: 40px; }
.breadcrumb a { min-height: 44px; display: inline-flex; align-items: center; }
.breadcrumb a:hover { text-decoration: underline; text-underline-offset: 5px; }
.commerce-title { margin-bottom: 24px; }
.commerce-page h1 { font-size: clamp(36px, 4.3vw, 64px); line-height: 1.5; max-width: 900px; }
.commerce-title > p, .shop-intro > div > p { font-size: 18px; margin-top: 12px; }
.commerce-demo-note { padding: 16px 20px; background: var(--sage); font-size: 16px; line-height: 1.9; margin-block: 24px 32px; }
.shop-intro { display: grid; grid-template-columns: 1.4fr 1fr; align-items: center; gap: 48px; }
.shop-intro > .photo { aspect-ratio: 3.5; }
.shop-toolbar { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 32px; margin-block: 36px 24px; }
.shop-toolbar label { display: block; margin-bottom: 10px; }
.shop-toolbar input { min-width: 0; }
.shop-toolbar select { width: 100%; height: 60px; padding: 10px 16px; font: inherit; color: var(--forest); background: var(--paper); border: 0; cursor: pointer; }
.shop-filters { margin-bottom: 24px; }
.catalogue-count { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-block: 24px; min-height: 44px; }
.reset-filters { display: inline-flex; align-items: center; gap: 12px; background: transparent; min-height: 44px; padding: 8px; text-decoration: underline; text-underline-offset: 5px; }
.catalogue-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px 28px; }
.catalogue-photo { display: block; position: relative; }
.catalogue-photo > .photo { aspect-ratio: 1.1; }
.catalogue-photo:hover img { transform: scale(1.035); }
.catalogue-product-info { display: flex; align-items: start; justify-content: space-between; gap: 12px; padding-top: 18px; }
.catalogue-product h2 { font-size: 20px; line-height: 1.65; }
.catalogue-product h2 a:hover { text-decoration: underline; text-underline-offset: 5px; }
.catalogue-product-info p { margin-top: 5px; font-size: 16px; }
.catalogue-product .price { margin-top: 12px; }
.limit-note { font-size: 16px; margin-top: 12px; }
button:disabled { opacity: .5; cursor: not-allowed; }
.commerce-empty { min-height: 420px; display: flex; align-items: center; justify-content: center; flex-direction: column; text-align: center; gap: 24px; padding-block: 56px; }
.commerce-empty h2 { font-size: clamp(28px, 3vw, 44px); }
.commerce-empty p { max-width: 520px; }
.commerce-feedback { position: sticky; bottom: 20px; z-index: 20; display: flex; align-items: center; gap: 16px; width: fit-content; margin-inline: auto; margin-top: 28px; background: var(--forest); color: var(--ivory); }
.commerce-feedback:not(:empty) { padding: 8px 16px; }
.commerce-feedback .icon-button:hover { color: var(--forest); }
.product-page-layout { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(32px, 6vw, 88px); align-items: start; }
.product-page-layout > .photo { aspect-ratio: .95; }
.product-page-copy h1 { font-size: clamp(36px, 3.6vw, 52px); margin-block: 12px; }
.product-page-copy > p:not(.product-page-price) { margin-block: 18px; }
.product-page-unit { color: var(--muted); }
.product-page-unit a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: underline; text-underline-offset: 5px; }
.product-page-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 14px; margin-block: 28px; }
.product-page-price bdi { font-size: 52px; font-weight: 600; line-height: 1.3; }
.product-page-price span { font-size: 16px; }
.product-purchase { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; }
.product-purchase > .button { flex: 1; min-height: 54px; min-width: 170px; }
.quantity-picker { display: inline-flex; align-items: center; gap: 4px; background: var(--paper); }
.quantity-picker button { width: 48px; height: 52px; display: grid; place-items: center; background: transparent; }
.quantity-picker button:hover:not(:disabled) { background: var(--sage); }
.quantity-picker output { min-width: 36px; text-align: center; font-size: 18px; font-variant-numeric: tabular-nums; }
.product-live-feedback { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-block: 20px; }
.product-live-feedback:empty { margin-block: 0; }
.product-live-feedback a { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; text-decoration: underline; }
.product-disclosure { padding-block: 16px; }
.product-disclosure summary { min-height: 44px; display: list-item; align-content: center; cursor: pointer; font-weight: 600; }
.product-disclosure p { margin-top: 12px; }
.related-section { margin-top: var(--space-section); }
.cart-page-layout, .delivery-page-layout { display: grid; grid-template-columns: minmax(0, 1fr) 380px; align-items: start; gap: clamp(28px, 5vw, 72px); margin-top: 40px; }
.cart-page-list { display: grid; gap: 32px; }
.cart-line { display: grid; grid-template-columns: 144px minmax(0, 1fr) auto; gap: 24px; align-items: start; }
.cart-line-photo img { width: 144px; height: 160px; object-fit: cover; }
.cart-line-copy h2 { font-size: 22px; line-height: 1.6; margin-bottom: 8px; }
.cart-line-copy > p { margin-bottom: 16px; }
.cart-line .quantity-picker button { width: 44px; height: 44px; }
.cart-line .quantity-picker output { min-width: 28px; }
.cart-line-end { display: flex; flex-direction: column; align-items: end; gap: 36px; }
.cart-line-end .price { margin: 0; }
.remove-line { min-height: 44px; display: inline-flex; align-items: center; gap: 8px; background: transparent; padding: 4px; }
.remove-line:hover { color: var(--forest-deep); text-decoration: underline; }
.cart-list-footer { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px; padding-top: 28px; }
.cart-storage-note { margin-top: 36px; }
.order-summary { background: var(--sage); padding: 32px; }
.order-summary h2 { font-size: 28px; }
.order-summary ul { list-style: none; padding: 0; display: grid; gap: 20px; margin: 28px 0; }
.order-summary li { display: flex; justify-content: space-between; align-items: start; gap: 16px; }
.order-summary small { display: block; font-size: 16px; margin-top: 4px; }
.summary-total { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-block: 28px; }
.summary-total strong { font-size: 36px; font-variant-numeric: tabular-nums; }
.order-summary p { margin-block: 18px; }
.order-summary > .button { width: 100%; margin-top: 8px; }
.summary-note { font-weight: 600; }
.undo-removal { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; background: var(--sage); padding: 12px 20px; margin-block: 24px; }
.undo-removal > button:not(.icon-button) { background: transparent; font-weight: 600; display: inline-flex; align-items: center; gap: 12px; min-height: 44px; text-decoration: underline; text-underline-offset: 5px; }
.delivery-form > h2, .address-review h2 { font-size: 30px; }
.delivery-form > p { margin-top: 12px; }
.address-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 28px 24px; margin-block: 32px; }
.address-field { min-width: 0; }
.address-field label { display: flex; gap: 16px; align-items: baseline; justify-content: space-between; margin-bottom: 10px; }
.address-field label span { font-size: 16px; color: var(--muted); }
.address-field input, .address-field textarea { display: block; width: 100%; min-height: 56px; padding: 12px 16px; background: var(--paper); border: 1px solid var(--muted); font: inherit; color: var(--forest); border-radius: 0; }
.address-field textarea { resize: vertical; }
.field-city, .field-address, .field-notes { grid-column: 1 / -1; }
.address-field [aria-invalid="true"] { border: 2px solid #8d2828; }
.field-error { margin-top: 8px; color: #8d2828; }
.form-error-summary { background: #f8e7dc; padding: 24px; margin-block: 28px; color: #692323; }
.form-error-summary h3 { font-size: 22px; }
.form-error-summary ul { margin: 12px 0 0; padding-inline-start: 20px; }
.form-error-summary a { display: inline-block; padding-block: 8px; text-decoration: underline; text-underline-offset: 5px; }
.delivery-policy-note { padding: 20px; background: var(--sage); margin-block: 24px; }
.delivery-back { margin-top: 20px; }
.delivery-form > .button { width: 100%; }
.address-review > h2 { margin-block: 16px; }
.address-review > p { margin-block: 16px; }
.address-review dl { display: grid; gap: 24px; margin-block: 32px; }
.address-review dl > div { display: grid; grid-template-columns: 100px minmax(0, 1fr); gap: 20px; }
.address-review dt { font-weight: 600; }
.address-review dd { margin: 0; overflow-wrap: anywhere; white-space: pre-wrap; }
.review-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; }
.product-detail > .text-link { margin-top: 16px; display: flex; }
bdi, output, .cart-count { font-variant-numeric: tabular-nums; }
.cart-loading { min-height: 420px; padding-top: 32px; }
.transaction-page .commerce-title h1 { font-size: 32px; }
.transaction-page .commerce-title > p { font-size: 16px; }
.transaction-page .breadcrumb { margin-bottom: 24px; }

@media (max-width: 1100px) {
  .catalogue-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .product-page-layout { gap: 32px; }
  .cart-page-layout, .delivery-page-layout { grid-template-columns: minmax(0, 1fr) 320px; gap: 28px; }
  .cart-line { grid-template-columns: 96px minmax(0, 1fr); gap: 16px; }
  .cart-line-photo img { width: 96px; height: 120px; }
  .cart-line-end { grid-column: 2; flex-direction: row; justify-content: space-between; align-items: center; gap: 16px; }
  .order-summary { padding: 24px; }
}
@media (max-width: 800px) {
  .cart-page-layout, .delivery-page-layout { grid-template-columns: 1fr; gap: 40px; }
  .shop-intro { gap: 28px; }
  .shop-toolbar { grid-template-columns: minmax(0, 1fr) 230px; gap: 20px; }
  .product-page-layout { grid-template-columns: 1fr; }
  .product-page-layout > .photo { aspect-ratio: 1.3; }
  .product-page-copy { max-width: 680px; }
  .cart-line { grid-template-columns: 128px minmax(0, 1fr) auto; }
  .cart-line-photo img { width: 128px; height: 144px; }
  .cart-line-end { grid-column: auto; flex-direction: column; align-items: end; }
}
@media (max-width: 600px) {
  .commerce-page { padding-top: 16px; padding-bottom: 56px; }
  .breadcrumb { gap: 8px; font-size: 16px; margin-bottom: 24px; }
  .commerce-page h1 { font-size: 36px; line-height: 1.5; }
  .commerce-title > p, .shop-intro > div > p { font-size: 16px; }
  .shop-intro { grid-template-columns: 1fr; gap: 24px; }
  .shop-intro > .photo { display: none; }
  .commerce-demo-note { margin-block: 24px; padding: 16px; }
  .shop-toolbar { grid-template-columns: minmax(0, 1fr) 140px; gap: 12px; margin-top: 28px; }
  .shop-toolbar select { height: 56px; }
  .catalogue-count { align-items: start; flex-direction: column; gap: 4px; }
  .catalogue-grid { gap: 32px 16px; }
  .catalogue-product h2 { font-size: 16px; }
  .catalogue-product-info { flex-wrap: wrap; gap: 12px; }
  .catalogue-product { position: relative; }
  .catalogue-product-info > .add-button { position: absolute; bottom: 0; inset-inline-end: 0; }
  .catalogue-product-info > div { flex: 1 1 100%; }
  .catalogue-product-info p { font-size: 16px; }
  .catalogue-photo > .photo { aspect-ratio: .95; }
  .catalogue-product .price { align-items: start; gap: 4px; flex-direction: column; padding-inline-end: 48px; min-height: 80px; }
  .catalogue-product .price > span { font-size: 13px; }
  .commerce-empty { min-height: 360px; padding-block: 32px; }
  .commerce-empty h2 { font-size: 28px; }
  .commerce-feedback { width: 100%; gap: 8px; bottom: 12px; font-size: 16px; }
  .product-page-layout > .photo { aspect-ratio: 1.4; }
  .product-page-copy h1 { font-size: 36px; }
  .product-page-price bdi { font-size: 44px; }
  .product-page-price { margin-block: 24px; }
  .product-purchase > .button { flex-basis: 100%; white-space: nowrap; }
  .related-section { margin-top: 64px; }
  .related-section .catalogue-grid > :last-child { grid-column: 1 / -1; max-width: 100%; }
  .related-section .catalogue-grid > :last-child .photo { aspect-ratio: 1.6; }
  .cart-line { grid-template-columns: 96px minmax(0, 1fr); gap: 16px; }
  .cart-line-photo img { width: 96px; height: 120px; }
  .cart-line-copy h2 { font-size: 18px; }
  .cart-line-end { grid-column: 2; flex-direction: row; align-items: center; justify-content: space-between; }
  .cart-list-footer { flex-direction: column; align-items: start; }
  .order-summary { padding: 24px 20px; }
  .order-summary h2 { font-size: 28px; }
  .undo-removal { padding: 12px 16px; gap: 8px 16px; }
  .address-fields { grid-template-columns: 1fr; gap: 24px; }
  .delivery-form > h2, .address-review h2 { font-size: 28px; }
  .form-error-summary { padding: 20px; }
  .address-review dl > div { grid-template-columns: 76px minmax(0, 1fr); gap: 12px; }
  .transaction-page .commerce-title h1 { font-size: 28px; }
  .shop-toolbar .search-input { padding-inline: 10px; gap: 8px; }
}
